datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  companies Company?
  createdAt DateTime @default(now())
  email     String?  @unique
  firstName String?
  id        String   @id @default(cuid())
  lastName  String?
  password  String
  roles     Json
  updatedAt DateTime @updatedAt
  username  String   @unique
}

model Company {
  businessRegistrationNumber String?
  createdAt                  DateTime            @default(now())
  currency                   EnumCompanyCurrency
  id                         String              @id @default(cuid())
  kraPin                     String?
  logo                       Json?
  name                       String?
  owner                      User?               @relation(fields: [owner], references: [id])
  owner                      String?             @unique
  updatedAt                  DateTime            @updatedAt
  website                    String?
}

enum EnumCompanyCurrency {
  Kes
  Usd
}
